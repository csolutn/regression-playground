# Copy to deploy.env (not in git). Read by the web container.
# SECRET_KEY: a long random string, e.g. from: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
MAX_CONCURRENT_TRAININGS=6
QUEUE_TIMEOUT_S=90
TRAINING_TIME_LIMIT_S=60
# 1 behind HTTPS (the Cloudflare Tunnel in compose.yaml, or your own HTTPS proxy): trust X-Forwarded-* and send
# the login cookie over HTTPS only. 0 when people open plain http://<this machine>:<port> (login fails with 1 there).
TRUST_PROXY=1

# The first teacher account, made when the app starts while there is no teacher yet. After the first
# start you may delete these lines; a password changed later is kept. (Or: docker compose exec web flask create-teacher)
ADMIN_LOGIN_ID=
ADMIN_NAME=
ADMIN_PASSWORD=

# Credits under the playground, each left out when empty: "© CREDIT_NAME" (a link to CREDIT_URL), a GitHub
# icon, an e-mail icon. For example CREDIT_NAME=2026 Your School, CREDIT_URL=https://example.com
CREDIT_NAME=
CREDIT_URL=
GITHUB_URL=
CONTACT_EMAIL=
