msgstr "입력 열을 한두 개 고르세요."

#, python-format
msgid "Class list imported: %(added)d added, %(updated)d updated."
msgstr "명단을 불러왔습니다: %(added)d명 추가, %(updated)d명 수정."

msgid "Close"
msgstr "닫기"

#, python-brace-format
msgid "Column not found in the CSV: {columns}"
msgstr "CSV에 없는 열: {columns}"

#, python-brace-format
msgid "Could not make the video: {msg}"
msgstr "영상을 만들지 못했습니다: {msg}"

