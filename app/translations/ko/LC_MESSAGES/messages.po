msgstr "취소"

msgid "Car speed → braking distance"
msgstr "자동차 속도 → 제동 거리"

msgid "Choose a CSV file."
msgstr "CSV 파일을 선택하세요."

msgid "Choose an output column that is not an input column."
msgstr "입력 열이 아닌 출력 열을 고르세요."

msgid "Choose at most two input columns."
msgstr "입력 열은 두 개까지 고를 수 있습니다."

msgid "Choose file…"
msgstr "파일 선택…"

