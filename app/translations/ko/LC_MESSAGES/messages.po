msgid "Student number"
msgstr "학번"

msgid "Student updated."
msgstr "학생 정보를 수정했습니다."

msgid "Students"
msgstr "학생"

msgid "Study hours → exam score"
msgstr "공부 시간 → 시험 점수"

msgid "Teacher"
msgstr "교사"

msgid "Temperature → ice cream sales"
msgstr "기온 → 아이스크림 판매량"

msgid "The CSV file could not be read."
msgstr "CSV 파일을 읽을 수 없습니다."

msgid "The CSV file is too large (max 1 MB)."
msgstr "CSV 파일이 너무 큽니다 (최대 1 MB)."

msgid "The CSV needs a header row with at least two columns."
msgstr "CSV 첫 줄에 열 이름이 두 개 이상 있어야 합니다."

msgid "The CSV needs at least 10 rows of numbers."
msgstr "CSV에 숫자로 된 행이 10개 이상 있어야 합니다."

msgid "The animation adds trees one at a time and averages them."
msgstr "애니메이션은 트리를 하나씩 더해 평균을 냅니다."

msgid "The animation grows the depth one level at a time."
msgstr "애니메이션은 트리 깊이를 한 단계씩 키웁니다."

msgid "The connection closed before the run was saved."
msgstr "실험이 저장되기 전에 연결이 끊겼습니다."

msgid "The file could not be read. Save it as CSV (UTF-8)."
msgstr "파일을 읽을 수 없습니다. CSV(UTF-8)로 저장해 주세요."

msgid "The formula gives invalid values (for example division by zero or the log of a negative number)."
msgstr "수식 값이 올바르지 않습니다 (예: 0으로 나누기, 음수의 log)."

msgid "The formula has a syntax error."
msgstr "수식의 문법이 올바르지 않습니다."

#, python-brace-format
msgid "The formula uses something that is not allowed. Use {vars}, numbers, + - * / ** and functions like sin, cos, exp, abs, sqrt, max."
msgstr "수식에 쓸 수 없는 것이 있습니다. {vars}, 숫자, + - * / ** 와 sin, cos, exp, abs, sqrt, max 같은 함수를 사용하세요."

msgid "The input range minimum must be smaller than the maximum."
msgstr "입력 범위의 최솟값은 최댓값보다 작아야 합니다."

msgid "The questions (x) and correct answers (y) the model learns from."
msgstr "모델이 배울 문제(x)와 정답(y)입니다."

msgid "The server is busy. Try again in a moment."
msgstr "지금 서버가 바쁩니다. 잠시 후 다시 시도해 주세요."

msgid "The shape of graph ŷ = f(x) the model can draw."
msgstr "모델이 그릴 수 있는 그래프 ŷ = f(x)의 모양입니다."

msgid "The student number and name do not match the class list. Ask your teacher."
msgstr "학번과 이름이 명단과 맞지 않습니다. 선생님께 문의하세요."

msgid "The two passwords are different."
msgstr "두 비밀번호가 다릅니다."

msgid "This browser can only record WebM, so the video was saved as WebM."
msgstr "이 브라우저는 WebM만 녹화할 수 있어 WebM으로 저장했습니다."

msgid "This browser cannot record video. Try the latest Chrome, Edge or Safari."
msgstr "이 브라우저는 영상을 만들 수 없습니다. 최신 Chrome, Edge, Safari를 사용하세요."

msgid "This is your first login. The password you type now becomes your password."
msgstr "첫 로그인입니다. 지금 입력한 비밀번호가 앞으로의 비밀번호가 됩니다."

msgid "Time"
msgstr "시각"

msgid "Title"
msgstr "제목"

msgid "To date"
msgstr "끝 날짜"

msgid "Today"
msgstr "오늘"

#, python-brace-format
msgid "Too much computation: {steps} update steps (limit {limit}). Reduce the epochs or use a larger batch."
msgstr "계산량이 너무 많습니다: 가중치 갱신 {steps}번 (한도 {limit}번). 에포크를 줄이거나 배치를 키우세요."

msgid "Train"
msgstr "학습"

msgid "Train loss"
msgstr "학습 손실"

msgid "Training data"
msgstr "훈련 데이터"

msgid "Training failed on the server. Try again."
msgstr "서버에서 학습 중 문제가 생겼습니다. 다시 시도해 주세요."

msgid "Training loss"
msgstr "학습 손실"

msgid "Training…"
msgstr "학습 중…"

msgid "Tree models do not draw a smooth curve: they cut x into boxes and predict one value per box."
msgstr "트리 모델은 매끄러운 곡선 대신 x를 여러 칸으로 나누고 칸마다 값 하나를 예측합니다."

msgid "Tree models do not use gradient descent. They learn by splitting the data into boxes."
msgstr "트리 모델은 경사하강법을 쓰지 않고, 데이터를 여러 칸으로 나누며 학습합니다."

msgid "Trees"
msgstr "트리 개수"

msgid "True function"
msgstr "실제 함수"

msgid "True function (grid)"
msgstr "실제 함수 (격자)"

#, python-brace-format
msgid "Unknown name in the formula: {name}. Use {vars}."
msgstr "수식에 모르는 이름이 있습니다: {name}. {vars}를 사용하세요."

msgid "Upload a CSV file first."
msgstr "먼저 CSV 파일을 올리세요."

#, python-format
msgid "Use a password of at least %(n)d characters."
msgstr "비밀번호는 %(n)d자 이상이어야 합니다."

msgid "Use x, numbers, + - * / ** and sin, cos, exp, log, abs, sqrt, tanh, max, min."
msgstr "x, 숫자, + - * / ** 와 sin, cos, exp, log, abs, sqrt, tanh, max, min을 쓸 수 있습니다."

msgid "Use x1, x2, numbers, + - * / ** and sin, cos, exp, log, abs, sqrt, tanh, max, min."
msgstr "x1, x2, 숫자, + - * / ** 와 sin, cos, exp, log, abs, sqrt, tanh, max, min을 쓸 수 있습니다."

msgid "Valid"
msgstr "검증"

msgid "Validation data"
msgstr "검증 데이터"

msgid "Validation loss"
msgstr "검증 손실"

msgid "Validation ratio"
msgstr "검증 데이터 비율"

msgid "Wait until training finishes."
msgstr "학습이 끝날 때까지 기다려 주세요."

msgid "Waiting for a free slot…"
msgstr "차례를 기다리는 중…"

msgid "Widths"
msgstr "구조"

msgid "Wrong password. If you forgot it, ask your teacher to reset it."
msgstr "비밀번호가 틀렸습니다. 잊었다면 선생님께 초기화를 요청하세요."

msgid "Yellow cells changed from the run before. Click a row to show it."
msgstr "노란 칸은 바로 전 실험과 달라진 설정입니다. 행을 누르면 그 실험을 보여 줍니다."

msgid "Your password is set to what you type at your first login."
msgstr "비밀번호는 첫 로그인시 입력한 값으로 설정됩니다."

msgid "average"
msgstr "평균"

msgid "batch 1"
msgstr "배치 1"

#, python-brace-format
msgid "batch {n}"
msgstr "배치 {n}"

#, python-brace-format
msgid "depth {d}"
msgstr "깊이 {d}"

#, python-brace-format
msgid "depth {d} (first {k} levels shown)"
msgstr "깊이 {d} (위 {k}단계만 표시)"

msgid "diverged"
msgstr "발산"

#, python-format
msgid "e.g. %(example)s"
msgstr "예) %(example)s"

msgid "full batch"
msgstr "전체 배치"

msgid "neurons"
msgstr "개"

msgid "noise"
msgstr "노이즈"

msgid "none (linear)"
msgstr "없음 (선형)"

msgid "not yet"
msgstr "미등록"

msgid "set"
msgstr "등록됨"

msgid "sum in order"
msgstr "차례로 더함"

msgid "time limit"
msgstr "시간 제한"

#, python-brace-format
msgid "vs #{n}:"
msgstr "#{n} 대비:"

#, python-brace-format
msgid "{field} must be between {min} and {max}."
msgstr "{field} 값은 {min}~{max} 사이여야 합니다."

#, python-brace-format
msgid "{f}: a straight line (or flat plane), {n} numbers to learn."
msgstr "{f}: 직선(또는 평면). 학습할 숫자 {n}개."

#, python-brace-format
msgid "{n} epochs"
msgstr "{n} 에포크"

#, python-brace-format
msgid "{n} of {total} runs"
msgstr "{total}개 중 {n}개"

#, python-brace-format
msgid "{n} points"
msgstr "데이터 {n}개"

#, python-brace-format
msgid "{n} trees of depth {d}, added one by one. Each new tree corrects the error that is left."
msgstr "깊이 {d}인 트리 {n}개를 하나씩 더합니다. 새 트리는 남은 오차를 보정합니다."

#, python-brace-format
msgid "{n} trees of depth {d}, each trained on a random sample of the data. The prediction is their average."
msgstr "깊이 {d}인 트리 {n}개를 각각 무작위 표본으로 학습합니다. 예측은 트리들의 평균입니다."

#, python-brace-format
msgid "{n} weights and biases to learn. Each hidden neuron bends the line with {act}."
msgstr "학습할 가중치·편향 {n}개. 은닉층 뉴런마다 {act}로 선을 구부립니다."

msgid "① Data"
msgstr "① 데이터"

msgid "② Model"
msgstr "② 모델"

msgid "③ Loss"
msgstr "③ 손실"

msgid "④ Optimization"
msgstr "④ 최적화"

msgid "■ Stop"
msgstr "■ 중지"

msgid "▶ Train"
msgstr "▶ 학습"

