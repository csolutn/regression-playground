msgstr "손실이 줄어들도록 그래프를 고치는 방법입니다."

msgid "Huber δ"
msgstr "Huber δ"

#, python-format
msgid "If you lose your password, ask your teacher, %(name)s."
msgstr "비밀번호를 분실할 경우 교사 %(name)s에게 문의하세요."

