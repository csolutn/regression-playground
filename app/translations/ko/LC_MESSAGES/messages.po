msgstr "CSV 파일"

msgid "CSV with columns student_id,name (or 학번,이름). Existing students keep their password and history."
msgstr "열 이름이 학번,이름(또는 student_id,name)인 CSV 파일. 이미 있는 학생의 비밀번호와 이력은 그대로 유지됩니다."

#, python-brace-format
msgid "Can a {act} neural network learn {f}?"
msgstr "{act} 신경망은 {f} 함수를 배울 수 있을까?"

#, python-brace-format
msgid "Can a {model} learn {f}?"
msgstr "{model} 모델은 {f} 함수를 배울 수 있을까?"

#, python-brace-format
msgid "Can linear regression learn {f}?"
msgstr "선형회귀는 {f} 함수를 배울 수 있을까?"

