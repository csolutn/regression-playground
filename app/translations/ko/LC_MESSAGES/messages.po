msgstr "삭제"

#, python-format
msgid "Delete %(name)s and all their runs?"
msgstr "%(name)s 학생과 모든 학습 이력을 삭제할까요?"

#, python-brace-format
msgid "Delete run #{n}? This cannot be undone."
msgstr "#{n} 실험을 삭제할까요? 되돌릴 수 없습니다."

