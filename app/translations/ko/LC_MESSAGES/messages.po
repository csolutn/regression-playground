msgid "Deleted %(name)s and their history."
msgstr "%(name)s 학생과 이력을 삭제했습니다."

msgid "Depth"
msgstr "트리 깊이"

msgid "Diverged: the loss became infinite. Try a smaller learning rate."
msgstr "발산: 손실이 무한대가 되었습니다. 학습률을 줄여 보세요."

msgid "Done"
msgstr "완료"

msgid "Download all runs (CSV)"
msgstr "전체 학습 이력 내려받기 (CSV)"

#, python-brace-format
msgid "Each hidden layer needs 1 to {max} neurons."
msgstr "은닉층마다 뉴런은 1~{max}개여야 합니다."

msgid "Enter a student number and a name."
msgstr "학번과 이름을 입력하세요."

msgid "Epoch"
msgstr "Epoch"

msgid "Epochs"
msgstr "에포크 (Epoch)"

msgid "Error"
msgstr "오류"

msgid "Errors smaller than δ are squared; bigger ones count linearly."
msgstr "δ보다 작은 오차는 제곱, 큰 오차는 그대로(선형) 셉니다."

